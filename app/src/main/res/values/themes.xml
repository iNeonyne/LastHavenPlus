<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lasthavens" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorAccent">@color/gold</item>
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="alertDialogTheme">@style/Theme.Lasthavens.Dialog</item>
    </style>
    <style name="Theme.Lasthavens.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/gold</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>
</resources>
