<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:alpha="0.95"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:background="@drawable/hero_fade" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingBottom="16dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.18"
            android:shadowColor="#99000000"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/gold_light"
            android:textSize="34sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"
            android:text="@string/tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPlay"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/btn_play"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="12dp"
            android:elevation="6dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.1"
            android:paddingHorizontal="40dp"
            android:stateListAnimator="@null"
            android:text="@string/play"
            android:textAllCaps="true"
            android:textColor="@color/on_gold"
            android:textSize="20sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnManager"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_manager"
            android:drawableStart="@drawable/ic_addons"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06"
            android:paddingHorizontal="40dp"
            android:stateListAnimator="@null"
            android:text="@string/addon_manager"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStorage"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/btn_manager"
            android:drawableStart="@drawable/ic_storage"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="40dp"
            android:text="@string/storage"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_manager"
            android:drawableStart="@drawable/ic_update"
            android:drawablePadding="12dp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="40dp"
            android:text="@string/update_check"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="18dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/versionApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:text="•"
                android:textColor="@color/gold_dark"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/versionAddons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
