<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.95"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_fade" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="36dp"
        android:paddingVertical="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.14"
                android:shadowColor="#99000000"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/gold_light"
                android:textSize="32sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.06"
                android:text="@string/tagline"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/versionApp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:text="•"
                    android:textColor="@color/gold_dark"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/versionAddons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlay"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/btn_play"
                android:drawableStart="@drawable/ic_play"
                android:drawablePadding="12dp"
                android:elevation="6dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"
                android:paddingHorizontal="24dp"
                android:stateListAnimator="@null"
                android:text="@string/play"
                android:textAllCaps="true"
                android:textColor="@color/on_gold"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnManager"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/btn_manager"
                android:drawableStart="@drawable/ic_addons"
                android:drawablePadding="12dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingHorizontal="24dp"
                android:stateListAnimator="@null"
                android:text="@string/addon_manager"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
